# Public site URL used for canonical links, sitemap, and JSON-LD
NEXT_PUBLIC_SITE_URL=https://anuragarya.io

# Contact form email (Brevo preferred — free tier)
# Verify BREVO_SENDER_EMAIL in Brevo → Senders before using
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=kumaranurag296@gmail.com
# BREVO_SENDER_NAME=Anurag Arya
# CONTACT_TO=kumaranurag296@gmail.com

# Optional legacy: Resend (used only if BREVO_API_KEY is unset)
# RESEND_API_KEY=re_xxx
# RESEND_FROM=Portfolio <onboarding@resend.dev>

# Search Console / webmaster verification tokens
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=
# NEXT_PUBLIC_YANDEX_VERIFICATION=
# NEXT_PUBLIC_PINTEREST_VERIFICATION=

# Google Analytics 4 (leave empty to disable — no GA network calls)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXX
# Set to "false" when a cookie banner controls consent (default: auto-grant)
# NEXT_PUBLIC_GA_AUTO_CONSENT=false

# Future / optional analytics providers (not primary)
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
# NEXT_PUBLIC_CLARITY_ID=
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=anuragarya.io
